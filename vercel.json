{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/.well-known/appspecific/com.tesla.3p.public-key.pem",
      "destination": "/.well-known/appspecific/com.tesla.3p.public-key.txt"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/appspecific/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ]
}
